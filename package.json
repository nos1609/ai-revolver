{
  "name": "ai-revolver",
  "version": "0.2.0",
  "description": "CLI profile manager for AI tools — instant credential switching",
  "type": "module",
  "bin": {
    "airev": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
