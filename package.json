{
  "name": "ai-revolver",
  "version": "0.2.1",
  "description": "CLI profile manager for AI tools — instant credential switching",
  "type": "module",
  "bin": {
    "airev": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:html": "stryker run --reporters html",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm run type-check && npm run test",
    "check:fix": "npm run lint:fix && npm run type-check && npm run test",
    "check:full": "npm run check && npm run coverage"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "ora": "^8.2.0",
    "yaml": "^2.7.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.15.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.4",
    "eslint-plugin-vitest": "^0.5.4",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "providers/"
  ],
  "license": "MIT"
}
