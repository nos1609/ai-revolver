{
  "name": "ai-revolver",
  "version": "0.2.1",
  "description": "Cross-platform CLI profile manager for AI coding tools",
  "type": "module",
  "packageManager": "npm@12.0.1",
  "bin": {
    "airev": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:html": "stryker run --reporters html",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "docs:check": "node scripts/check-docs.mjs",
    "check": "npm run lint && npm run type-check && npm run test && npm run docs:check",
    "check:fix": "npm run lint:fix && npm run type-check && npm run test && npm run docs:check",
    "check:full": "npm run check && npm run coverage",
    "prepack": "npm run check && npm run build"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "ora": "^8.2.0",
    "yaml": "^2.7.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^22.15.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.4",
    "tsup": "^8.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai-cli",
    "credential-manager",
    "profile-manager",
    "oauth"
  ],
  "files": [
    "dist/",
    "providers/",
    "docs/README.md",
    "docs/DOCUMENTATION_STANDARD.md",
    "docs/architecture/",
    "docs/operations/",
    "docs/security.md",
    "docs/troubleshooting.md",
    "docs/releasing.md",
    "docs/source-attribution.md",
    "docs/notes/2026-06-22-qodercli-reverse-engineering.md",
    "README.en.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.en.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  },
  "license": "MIT"
}
